module.exports = {
    build: './build/web',
    // Rolling GitHub release per channel: tag = tagPrefix + channel,
    // assets = `<VERSION>.zip` + meta file. The update URL is static:
    // `https://github.com/<owner>/<repo>/releases/download/<tag>/latest`
    // (no REST API, app code untouched — see audit §6.3).
    tagPrefix: 'web-',
    // Name of the meta asset. MUST stay the last URL segment of the
    // `applicationUpdateURL` baked into the client.
    meta: 'latest',
    // Channel override for manual runs (`CHANNEL=... node deploy-web.js`).
    // In CI the channel is derived from GITHUB_REF instead.
    channel: process.env.CHANNEL || '',
};
