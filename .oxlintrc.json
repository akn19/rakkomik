{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "env": {
        "es6": true,
        "node": true,
        "browser": true,
        "jest": true
    },
    "globals": {
        "PDFDocument": "readonly",
        "HakuNeko": "readonly",
        "Engine": "readonly",
        "EventListener": "readonly",
        "Connector": "readonly",
        "ClipboardConnector": "readonly"
    },
    "rules": {
        "unicorn/prefer-node-protocol": "error",
        "unicorn/no-new-buffer": "error"
    }
}
