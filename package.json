{
  "name": "hakuneko-dev",
  "version": "1.0.0",
  "description": "HakuNeko",
  "author": "The HakuNeko Development Team <https://github.com/orgs/manga-download/people>",
  "license": "Unlicense",
  "main": "src/app/main.js",
  "repository": {
    "type": "git",
    "url": "https://git.io/hakuneko"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-virtual": "3.14.13",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "innosetup-compiler": "6.3.1",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "jszip": "3.10.2",
    "knip": "6.39.0",
    "lucide-react": "1.53.0",
    "merge-stream": "2.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "polymer-build": "3.1.4",
    "puppeteer-core": "24.43.1",
    "rcedit": "5.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vinyl-fs": "4.0.2",
    "vite": "8.3.3",
    "win-7zip": "0.1.1"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && cd src/app && pnpm install --no-optional",
    "start": "pnpm run start:dev",
    "start:dev": "electron . --update-url=DISABLED --cache-directory=./src/web --disable-http-cache",
    "start:build": "pnpm run build:web && electron . --update-url=DISABLED --cache-directory=./build/latest",
    "lint": "pnpm run lint:app && pnpm run lint:web",
    "lint:app": "oxlint ./src/app --ignore-path .gitignore",
    "lint:web": "oxlint ./src/web/mjs ./src/web/ui --ignore-path .gitignore",
    "format": "pnpm run format:app && pnpm run format:web",
    "format:app": "oxfmt --write ./src/app",
    "format:web": "oxfmt --write ./src/web/mjs ./src/web/ui",
    "build:app": "node build-app.js",
    "build:web": "pnpm run build:ui && node build-web.js",
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "deploy:web": "pnpm run build:web && node deploy-web.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --color --reporters=default --reporters=jest-junit",
    "test:app": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --color --reporters=default --reporters=jest-junit --testPathPatterns=/src/app",
    "test:web": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --color --reporters=default --reporters=jest-junit --testPathPatterns=/src/web",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --color --reporters=default --reporters=jest-junit --testPathPatterns=/src/__tests__",
    "knip": "knip",
    "check:deprecated": "node scripts/check-deprecated.js"
  }
}
