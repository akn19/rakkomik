{
  "name": "hakuneko-dev",
  "version": "1.0.0",
  "description": "HakuNeko",
  "author": "The HakuNeko Development Team <https://github.com/orgs/manga-download/people>",
  "license": "Unlicense",
  "main": "src/app/main.js",
  "repository": {
    "type": "git",
    "url": "https://git.io/hakuneko"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@hakuneko/ffmpeg-binaries": "4.2.1-1",
    "@hakuneko/imagemagick-binaries": "7.0.8-58-3",
    "@hakuneko/kindlegen-binaries": "2.9.0-3",
    "@logtrine/logtrine": "1.1.2",
    "discord-rpc": "4.0.1",
    "electron": "8.3.4",
    "fs-extra": "11.4.1",
    "innosetup-compiler": "6.3.1",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "jszip": "3.10.2",
    "knip": "6.39.0",
    "merge-stream": "2.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "polymer-build": "3.1.4",
    "puppeteer-core": "24.43.1",
    "rcedit": "5.0.2",
    "vinyl-fs": "4.0.2",
    "win-7zip": "0.1.1"
  },
  "scripts": {
    "postinstall": "cd src/app && pnpm install --no-optional",
    "start": "pnpm run start:dev",
    "start:dev": "electron . --update-url=DISABLED --cache-directory=./src/web --disable-http-cache",
    "start:build": "pnpm run build:web && electron . --update-url=DISABLED --cache-directory=./build/latest",
    "lint": "pnpm run lint:app && pnpm run lint:web",
    "lint:app": "oxlint ./src/app --ignore-path .gitignore",
    "lint:web": "oxlint ./src/web/mjs --ignore-path .gitignore",
    "format": "pnpm run format:app && pnpm run format:web",
    "format:app": "oxfmt --write ./src/app",
    "format:web": "oxfmt --write ./src/web/mjs",
    "build:app": "node build-app.js",
    "build:web": "node build-web.js",
    "deploy:web": "pnpm run build:web && node deploy-web.js",
    "test": "jest --color --reporters=default --reporters=jest-junit",
    "test:app": "jest --color --reporters=default --reporters=jest-junit --testPathPatterns=/src/app",
    "test:web": "jest --color --reporters=default --reporters=jest-junit --testPathPatterns=/src/web",
    "test:e2e": "jest --color --reporters=default --reporters=jest-junit --testPathPatterns=/src/__tests__",
    "knip": "knip",
    "check:deprecated": "node scripts/check-deprecated.js"
  }
}
