    electron: require('electron/package.json').version,
    author: 'RakKomik contributors <https://github.com/akn19/rakkomik>',
    name: {
        package: 'rakkomik',
        product: 'RakKomik',
    },
    description: {
        short: 'Manga and comic downloader',
        long: 'Desktop client of RakKomik, a downloader for manga and comics from various websites'
    },
    license: 'Unlicense',
    url: 'https://github.com/akn19/rakkomik',
    // the bundle identifier of the macOS application, in reverse domain notation
    identifier: 'io.github.akn19.rakkomik',
    src: 'src/app',
    binary: {
        windows: 'rakkomik.exe',
        linux: 'rakkomik',
        darwin: 'RakKomik'
    },
    meta: {
        section: 'net',
        type: 'Application',
        categories: 'Network;FileTransfer;',
        dependencies: {
